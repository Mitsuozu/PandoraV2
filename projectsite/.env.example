# Copy this file to projectsite/.env and fill in your own details.
# .env is ignored by git, so passwords and keys stay on the machine.

# Local development (MySQL 8.4+, required by Django 6.1)
PANDORA_DB_NAME=pandorav2db
PANDORA_DB_USER=root
PANDORA_DB_PASSWORD=
PANDORA_DB_HOST=127.0.0.1
PANDORA_DB_PORT=3306

# PythonAnywhere (see DEPLOY.md). Uncomment and fill in:
PANDORA_DB_ENGINE=sqlite
# PANDORA_DEBUG=False
# PANDORA_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# PANDORA_SECRET_KEY=paste-a-long-random-string-here

# Optional Google / GitHub sign-in (see SETUP.md). Leave unset to hide the buttons.
# PANDORA_GOOGLE_CLIENT_ID=
# PANDORA_GOOGLE_SECRET=
# PANDORA_GITHUB_CLIENT_ID=
# PANDORA_GITHUB_SECRET=
